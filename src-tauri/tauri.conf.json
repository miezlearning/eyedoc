{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EyeDoc",
  "version": "1.0.0",
  "identifier": "com.eyedoc.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EyeDoc - Word Cloud Auto-Sync",
        "width": 1020,
        "height": 740,
        "minWidth": 840,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,Translate,MediaRouter,OptimizationHints --disable-background-networking --disable-extensions --disable-sync --disable-component-update --no-first-run --js-flags=--max-old-space-size=128"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
